# Browser calls go through Next.js → /api-proxy → backend (see next.config.ts).
# Optional: set full URL to bypass proxy (e.g. production).
NEXT_PUBLIC_API_URL=https://api.reckon.cronberry.com

# Used for “Continue with Google” (must be the real API URL, not /api-proxy).
NEXT_PUBLIC_BACKEND_ORIGIN=https://api.reckon.cronberry.com

# Optional: where Next should proxy /api-proxy (default 127.0.0.1:4000).
# BACKEND_PROXY_TARGET=http://127.0.0.1:4000
